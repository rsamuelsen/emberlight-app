{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "The launcher window: its own commands, window dragging/minimising and the folder picker.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "dialog:allow-open"
  ]
}
