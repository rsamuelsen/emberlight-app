{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Emberlight Companion",
  "version": "0.3.3",
  "identifier": "org.emberlight.launcher",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Emberlight Companion",
        "width": 1400,
        "height": 860,
        "minWidth": 1180,
        "minHeight": 740,
        "center": true,
        "decorations": false,
        "resizable": true,
        "backgroundColor": "#070b16"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; script-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "dmg",
      "app"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDVBRTAwOEY4NjY2QkUxMzQKUldRMDRXdG0rQWpnV3U3S3VNc2h1VXZpTk8xSDBUaTlnb1pnMENSV2JXQ0M2ZlIrdndTejBZb2cK",
      "endpoints": [
        "https://emberlightrp.com/v1/releases/launcher/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
